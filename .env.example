# Supabase — anon key/URL은 클라이언트에 노출되는 값(RLS로 보호), service role key는 서버 전용이라 절대 공개 금지
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel Cron이 /api/cron/briefing을 호출할 때 쓰는 인증 토큰 (Authorization: Bearer <값>)
CRON_SECRET=

# Google Vertex AI (Idea Build / 뉴스 브리핑 생성용 Gemini 클라이언트)
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# Tavily 검색 API (채용공고 수집)
TAVILY_API_KEY=

# 채용공고 알림 발송용 SMTP
GOOGLE_SMTP_HOST=
GOOGLE_SMTP_PORT=
GOOGLE_SMTP_USER=
GOOGLE_SMTP_PASSWORD=

# 기상청 API허브 authKey — 초단기예보(getUltraSrtFcst), 헤더 날씨
KMA_AUTH_KEY=

# 공공데이터포털 서비스키 — AirKorea 대기질 + 기상청 기상특보 공용 (원문 그대로, %-인코딩하지 않은 값)
AIRKOREA_SERVICE_KEY=
